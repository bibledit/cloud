msgstr "Buat"

msgid "Drag the list of workspaces into the desired order."
msgstr "Seret daftar ruang kerja ke urutan yang diinginkan."

msgid "Click 🗑 to remove the workspace."
msgstr "Klik 🗑 untuk menghapus ruang kerja."

msgid "Click ✎ to edit the workspace."
msgstr "Klik ✎ untuk mengedit ruang kerja."

msgid "Click ⎘ to copy the workspace to a new one."
msgstr "Klik ⎘ untuk menyalin ruang kerja menjadi yang baru."

msgid "Click ✉ to send the workspace to all users."
msgstr "Klik ✉ untuk mengirim ruang kerja ke semua pengguna."

msgid "Create a new workspace."
msgstr "Buat ruang kerja baru."

msgid "Create all default workspaces."
msgstr "Buat semua ruang kerja bawaan."

