msgstr "Título principal da introdução nível 2"

msgid "Introduction major title, level 2."
msgstr "Título principal da introdução, nível 2."

msgid "Introduction major title level 3"
msgstr "Título principal da introdução nível 3"

msgid "Introduction major title, level 3."
msgstr "Título principal da introdução, nível 3."

msgid "Introduction major title level 4"
msgstr "Título principal da introdução nível 4"

msgid "Introduction major title, level 4."
msgstr "Título principal da introdução, nível 4."

msgid "Introduction section heading level 1"
msgstr "Título de seção da introdução nível 1"

msgid "Introduction section heading, level 1, if single level."
msgstr "Título de seção da introdução, nível 1, se houver um único nível."

msgid "Introduction section heading, level 1, if multiple levels."
msgstr "Título de seção da introdução, nível 1, se houver vários níveis."

msgid "Introduction section heading level 2"
msgstr "Título de seção da introdução nível 2"

msgid "Introduction section heading, level 2."
msgstr "Título de seção da introdução, nível 2."

msgid "Introduction paragraph"
msgstr "Parágrafo da introdução"

msgid "Introduction prose paragraph."
msgstr "Parágrafo em prosa da introdução."

msgid "Indented introduction paragraph"
msgstr "Parágrafo da introdução com recuo"

msgid "Introduction prose paragraph, with first line indent."
msgstr "Parágrafo em prosa da introdução, com recuo na primeira linha."

msgid "Introduction margin paragraph"
msgstr "Parágrafo de margem da introdução"

msgid ""
"Introduction prose paragraph, with no first line indent. May occur after "
"poetry."
msgstr "Parágrafo em prosa da introdução, sem recuo na primeira linha. Pode ocorrer após poesia."

msgid "Indented introduction margin paragraph"
msgstr "Parágrafo de margem da introdução com recuo"

msgid ""
"Introduction prose paragraph text, indented, with no first line indent."
msgstr "Texto de parágrafo em prosa da introdução, com recuo, sem recuo na primeira linha."

msgid "Introduction quote from text paragraph"
msgstr "Parágrafo da introdução com citação do texto"

msgid "Introduction prose paragraph, quote from the body text."
msgstr "Parágrafo em prosa da introdução, citação do corpo do texto."

msgid "Introduction margin quote from text paragraph"
msgstr "Parágrafo de margem da introdução com citação do texto"

msgid ""
"Introduction prose paragraph, quote from the body text, with no first line "
"indent."
msgstr "Parágrafo em prosa da introdução, citação do corpo do texto, sem recuo na primeira linha."

msgid "Introduction paragraph right-aligned"
msgstr "Parágrafo da introdução alinhado à direita"

msgid "Introduction prose paragraph, right aligned."
msgstr "Parágrafo em prosa da introdução, alinhado à direita."

msgid "Introduction poetic line"
msgstr "Linha poética da introdução"

msgid "Introduction poetry text, level 1, if single level."
msgstr "Texto poético da introdução, nível 1, se houver um único nível."

