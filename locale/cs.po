msgstr "Záhlaví tabulky, sloupec 4."

msgid "Right aligned table column 1 heading"
msgstr "Záhlaví sloupce 1 tabulky zarovnané doprava"

msgid "A table heading, column 1, right aligned."
msgstr "Záhlaví tabulky, sloupec 1, zarovnané doprava."

msgid "Right aligned table column 2 heading"
msgstr "Záhlaví sloupce 2 tabulky zarovnané doprava"

