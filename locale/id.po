msgstr "Untuk isi nilai entri daftar tingkat 1."

msgid "List entry value level 2"
msgstr "Nilai entri daftar tingkat 2"

msgid "For list entry value content level 2."
msgstr "Untuk isi nilai entri daftar tingkat 2."

