msgid "ETCBC4 Hebrew text database"
msgstr "ETCBC4 hebrajų teksto duomenų bazė"

msgid ""
"The ETCBC database of the Hebrew Bible contains the scholarly text of the "
"Hebrew Bible with linguistic markup."
msgstr "ETCBC hebrajų Biblijos duomenų bazėje yra mokslinis hebrajų Biblijos tekstas su lingvistiniu žymėjimu."

msgid "Original data source:"
msgstr "Pradinis duomenų šaltinis:"

msgid "Bibledit's data source:"
msgstr "„Bibledit“ duomenų šaltinis:"

msgid "SHEBANQ, a search engine for the Hebrew Bible"
msgstr "SHEBANQ – hebrajų Biblijos paieškos variklis"

msgid "License:"
msgstr "Licencija:"

