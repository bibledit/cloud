msgstr "Entrada de lista nivel 1"

msgid "List entry level 2"
msgstr "Entrada de lista nivel 2"

msgid "List entry level 3"
msgstr "Entrada de lista nivel 3"

msgid "A list entry, level 3."
msgstr "Una entrada de lista, nivel 3."

msgid "List entry level 4"
msgstr "Entrada de lista nivel 4"

msgid "A list entry, level 4."
msgstr "Una entrada de lista, nivel 4."

msgid "List footer"
msgstr "Pie de lista"

