msgstr "Paragraf berindentasi dengan indentasi menggantung, tingkat 3."

msgid "Paragraph with hanging indent level 4"
msgstr "Paragraf dengan indentasi menggantung tingkat 4"

msgid "Indented paragraph with hanging indent, level 4."
msgstr "Paragraf berindentasi dengan indentasi menggantung, tingkat 4."

msgid "Blank line"
msgstr "Baris kosong"

