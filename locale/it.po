msgstr "Paragrafo dell'introduzione"

msgid "Introduction prose paragraph."
msgstr "Paragrafo in prosa dell'introduzione."

msgid "Indented introduction paragraph"
msgstr "Paragrafo rientrato dell'introduzione"

msgid "Introduction prose paragraph, with first line indent."
msgstr "Paragrafo in prosa dell'introduzione, con rientro della prima riga."

msgid "Introduction margin paragraph"
msgstr "Paragrafo a margine dell'introduzione"

msgid ""
"Introduction prose paragraph, with no first line indent. May occur after "
