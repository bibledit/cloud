msgstr "Mawu a ndakatulo, chizindikiro cha acrostic cha chilembo choyamba cha mzere wa ndakatulo ya acrostic."

msgid "Embedded text poetic line"
msgstr "Mzere wa ndakatulo wa mawu olowetsedwa"

msgid "Poetry text, embedded, level 1 indent, if single level."
msgstr "Mawu a ndakatulo, olowetsedwa, kulowetsa mlingo 1, ngati pali mlingo umodzi."

msgid "Embedded text poetic line level 1"
msgstr "Mzere wa ndakatulo wa mawu olowetsedwa mlingo 1"

msgid "Poetry text, embedded, level 1 indent, if multiple levels."
msgstr "Mawu a ndakatulo, olowetsedwa, kulowetsa mlingo 1, ngati pali milingo ingapo."

msgid "Embedded text poetic line level 2"
msgstr "Mzere wa ndakatulo wa mawu olowetsedwa mlingo 2"

msgid "Poetry text, embedded, level 2 indent."
msgstr "Mawu a ndakatulo, olowetsedwa, kulowetsa mlingo 2."

msgid "Embedded text poetic line level 3"
msgstr "Mzere wa ndakatulo wa mawu olowetsedwa mlingo 3"

msgid "Poetry text, embedded, level 3 indent."
msgstr "Mawu a ndakatulo, olowetsedwa, kulowetsa mlingo 3."

msgid "Hebrew note"
msgstr "Cholemba cha Chihebri"

