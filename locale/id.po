msgstr "Judul bagian, tingkat 1, jika hanya satu tingkat."

msgid "Section heading level 1"
msgstr "Judul bagian tingkat 1"

msgid "A section heading, level 1, if multiple levels."
msgstr "Judul bagian, tingkat 1, jika beberapa tingkat."

msgid "Section heading level 2"
msgstr "Judul bagian tingkat 2"

