msgstr "Judul utama penutup pendahuluan tingkat 1"

msgid "Introduction major title ending level 2"
msgstr "Judul utama penutup pendahuluan tingkat 2"

msgid "Introduction end"
msgstr "Akhir pendahuluan"

msgid ""
"Optionally included to explicitly indicate the end of the introduction "
"material."
msgstr "Dapat disertakan untuk menunjukkan secara eksplisit akhir materi pendahuluan."

msgid "Major title"
msgstr "Judul utama"

msgid "The main title of the book, if single level."
msgstr "Judul utama kitab, jika hanya satu tingkat."

msgid "Major title level 1"
msgstr "Judul utama tingkat 1"

msgid "The main title of the book, level 1 if multiple levels."
msgstr "Judul utama kitab, tingkat 1 jika beberapa tingkat."

msgid "Major title level 2"
msgstr "Judul utama tingkat 2"

msgid "The main title of the book, level 2."
msgstr "Judul utama kitab, tingkat 2."

msgid "Major title level 3"
msgstr "Judul utama tingkat 3"

msgid "A secondary title, less important than the main title."
msgstr "Judul sekunder, kurang penting daripada judul utama."

msgid "Major title level 4"
msgstr "Judul utama tingkat 4"

msgid "A small secondary title sometimes occurring within parentheses."
msgstr "Judul sekunder kecil yang kadang muncul dalam tanda kurung."

msgid "Major title at ending"
msgstr "Judul utama di akhir"

msgid ""
"The main title of the book repeated at the end of the book, if single level."
msgstr "Judul utama kitab yang diulang di akhir kitab, jika hanya satu tingkat."

msgid "Major title at ending level 1"
msgstr "Judul utama di akhir tingkat 1"

msgid ""
"The main title of the book repeated at the end of the book, if multiple "
"levels."
msgstr "Judul utama kitab yang diulang di akhir kitab, jika beberapa tingkat."

msgid "Major title at ending level 2"
msgstr "Judul utama di akhir tingkat 2"

msgid "A secondary title occurring before or after the ending main title."
msgstr "Judul sekunder yang muncul sebelum atau sesudah judul utama penutup."

msgid "Major section heading"
msgstr "Judul bagian utama"

msgid "A major section division heading, level 1, if single level."
msgstr "Judul pembagian bagian utama, tingkat 1, jika hanya satu tingkat."

msgid "Major section heading level 1"
msgstr "Judul bagian utama tingkat 1"

msgid "A major section division heading, level 1, if multiple levels."
msgstr "Judul pembagian bagian utama, tingkat 1, jika beberapa tingkat."

msgid "Major section heading level 2"
msgstr "Judul bagian utama tingkat 2"

