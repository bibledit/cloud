msgstr "Refrein teks sisipan"

msgid "Embedded text refrain, e.g. Then all the people shall say, Amen!"
msgstr "Refrein teks sisipan, misalnya Maka seluruh bangsa itu akan berkata: Amin!"

msgid "Indented paragraph"
msgstr "Paragraf berindentasi"

msgid ""
"Paragraph text, level 1 indent if single level, with first line indent; "
"often used for discourse."
msgstr "Teks paragraf, indentasi tingkat 1 jika hanya satu tingkat, dengan indentasi baris pertama; sering digunakan untuk percakapan."

msgid "Indented paragraph level 1"
msgstr "Paragraf berindentasi tingkat 1"

msgid ""
"Paragraph text, level 1 indent if multiple levels, with first line indent; "
"often used for discourse."
msgstr "Teks paragraf, indentasi tingkat 1 jika beberapa tingkat, dengan indentasi baris pertama; sering digunakan untuk percakapan."

msgid "Indented paragraph level 2"
msgstr "Paragraf berindentasi tingkat 2"

msgid ""
"Paragraph text, level 2 indent if multiple levels, with first line indent; "
"often used for discourse."
msgstr "Teks paragraf, indentasi tingkat 2 jika beberapa tingkat, dengan indentasi baris pertama; sering digunakan untuk percakapan."

