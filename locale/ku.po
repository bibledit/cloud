msgid "Display all notes assigned to you."
msgstr "Hemû têbîniyên ku ji we re hatine dayîn nîşan bide."

msgid "Display all notes you are subscribed to."
msgstr "Hemû têbîniyên ku hûn endamê wan in nîşan bide."

