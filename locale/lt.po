msgstr "Įvado prozos pastraipa, citata iš pagrindinio teksto, be pirmos eilutės įtraukos."

msgid "Introduction paragraph right-aligned"
msgstr "Įvado pastraipa lygiuota į dešinę"

msgid "Introduction prose paragraph, right aligned."
msgstr "Įvado prozos pastraipa, lygiuota į dešinę."

msgid "Introduction poetic line"
msgstr "Įvado poetinė eilutė"

msgid "Introduction poetry text, level 1, if single level."
msgstr "Įvado poezijos tekstas, 1 lygio, jei vienas lygis."

msgid "Introduction poetic line level 1"
msgstr "Įvado poetinė eilutė 1 lygio"

msgid "Introduction poetry text, level 1, if multiple levels."
msgstr "Įvado poezijos tekstas, 1 lygio, jei keli lygiai."

msgid "Introduction poetic line level 2"
msgstr "Įvado poetinė eilutė 2 lygio"

msgid "Introduction poetry text, level 2, if multiple levels."
msgstr "Įvado poezijos tekstas, 2 lygio, jei keli lygiai."

msgid "Introduction poetic line level 3"
msgstr "Įvado poetinė eilutė 3 lygio"

msgid "Introduction poetry text, level 3, if multiple levels."
msgstr "Įvado poezijos tekstas, 3 lygio, jei keli lygiai."

msgid "Introduction blank line"
msgstr "Įvado tuščia eilutė"

msgid ""
"May be used to explicitly indicate additional white space between paragraphs."
msgstr "Gali būti naudojama aiškiai nurodyti papildomą tuščią erdvę tarp pastraipų."

msgid "Introduction list item"
msgstr "Įvado sąrašo elementas"

msgid "A list entry, level 1, if single level."
msgstr "Sąrašo įrašas, 1 lygio, jei vienas lygis."

msgid "Introduction list item level 1"
msgstr "Įvado sąrašo elementas 1 lygio"

msgid "A list entry, level 1, if multiple levels."
msgstr "Sąrašo įrašas, 1 lygio, jei keli lygiai."

msgid "Introduction list item level 2"
msgstr "Įvado sąrašo elementas 2 lygio"

msgid "A list entry, level 2."
msgstr "Sąrašo įrašas, 2 lygio."

msgid "Introduction outline title"
msgstr "Įvado plano pavadinimas"

msgid "Introduction outline title."
msgstr "Įvado plano pavadinimas."

msgid "Introduction outline entry"
msgstr "Įvado plano įrašas"

msgid "Introduction outline text, level 1, if single level."
msgstr "Įvado plano tekstas, 1 lygio, jei vienas lygis."

msgid "Introduction outline entry level 1"
msgstr "Įvado plano įrašas 1 lygio"

msgid "Introduction outline text, level 1, if multiple levels."
msgstr "Įvado plano tekstas, 1 lygio, jei keli lygiai."

msgid "Introduction outline entry level 2"
msgstr "Įvado plano įrašas 2 lygio"

msgid "Introduction outline text, level 2."
msgstr "Įvado plano tekstas, 2 lygio."

msgid "Introduction outline entry level 3"
msgstr "Įvado plano įrašas 3 lygio"

msgid "Introduction outline text, level 3."
msgstr "Įvado plano tekstas, 3 lygio."

msgid "Introduction outline entry level 4"
msgstr "Įvado plano įrašas 4 lygio"

msgid "Introduction outline text, level 4."
msgstr "Įvado plano tekstas, 4 lygio."

msgid "Introduction outline reference range"
msgstr "Įvado plano nuorodų intervalas"

msgid ""
"Introduction references range for outline entry; for marking references "
"separately."
msgstr "Įvado nuorodų intervalas plano įrašui; nuorodoms žymėti atskirai."

msgid "Introduction quoted text"
msgstr "Įvado cituojamas tekstas"

msgid ""
"Scripture quotations, or other quoted text, appearing in the introduction."
msgstr "Šventojo Rašto citatos ar kitas cituojamas tekstas, pasirodantis įvade."

msgid "Explanatory or bridge text"
msgstr "Aiškinamasis ar jungiamasis tekstas"

msgid ""
"Introduction explanatory or bridge text, e.g. explanation of missing book in "
"short Old Testament."
msgstr "Įvado aiškinamasis ar jungiamasis tekstas, pvz., trūkstamos knygos paaiškinimas trumpame Senajame Testamente."

msgid "Introduction major title ending"
msgstr "Įvado pagrindinės antraštės pabaiga"

msgid "Used to mark a major title indicating the end of the introduction."
msgstr "Naudojama pagrindinei antraštei, žyminčiai įvado pabaigą, pažymėti."

msgid "Introduction major title ending level 1"
msgstr "Įvado pagrindinės antraštės pabaiga 1 lygio"

msgid "Introduction major title ending level 2"
msgstr "Įvado pagrindinės antraštės pabaiga 2 lygio"

msgid "Introduction end"
msgstr "Įvado pabaiga"

msgid ""
"Optionally included to explicitly indicate the end of the introduction "
"material."
msgstr "Pasirinktinai įtraukiama aiškiai nurodyti įvado medžiagos pabaigą."

msgid "Major title"
msgstr "Pagrindinė antraštė"

msgid "The main title of the book, if single level."
msgstr "Pagrindinė knygos antraštė, jei vienas lygis."

msgid "Major title level 1"
msgstr "Pagrindinė antraštė 1 lygio"

msgid "The main title of the book, level 1 if multiple levels."
msgstr "Pagrindinė knygos antraštė, 1 lygio, jei keli lygiai."

msgid "Major title level 2"
msgstr "Pagrindinė antraštė 2 lygio"

msgid "The main title of the book, level 2."
msgstr "Pagrindinė knygos antraštė, 2 lygio."

msgid "Major title level 3"
msgstr "Pagrindinė antraštė 3 lygio"

msgid "A secondary title, less important than the main title."
msgstr "Antrinė antraštė, mažiau svarbi nei pagrindinė antraštė."

msgid "Major title level 4"
msgstr "Pagrindinė antraštė 4 lygio"

msgid "A small secondary title sometimes occurring within parentheses."
msgstr "Maža antrinė antraštė, kartais esanti skliaustuose."

msgid "Major title at ending"
msgstr "Pagrindinė antraštė pabaigoje"

msgid ""
"The main title of the book repeated at the end of the book, if single level."
msgstr "Pagrindinė knygos antraštė, pakartota knygos pabaigoje, jei vienas lygis."

msgid "Major title at ending level 1"
msgstr "Pagrindinė antraštė pabaigoje 1 lygio"

msgid ""
"The main title of the book repeated at the end of the book, if multiple "
"levels."
msgstr "Pagrindinė knygos antraštė, pakartota knygos pabaigoje, jei keli lygiai."

msgid "Major title at ending level 2"
msgstr "Pagrindinė antraštė pabaigoje 2 lygio"

msgid "A secondary title occurring before or after the ending main title."
msgstr "Antrinė antraštė, esanti prieš pabaigos pagrindinę antraštę arba po jos."

msgid "Major section heading"
msgstr "Pagrindinė skyriaus antraštė"

msgid "A major section division heading, level 1, if single level."
msgstr "Pagrindinio skirsnio padalijimo antraštė, 1 lygio, jei vienas lygis."

msgid "Major section heading level 1"
msgstr "Pagrindinė skyriaus antraštė 1 lygio"

msgid "A major section division heading, level 1, if multiple levels."
msgstr "Pagrindinio skirsnio padalijimo antraštė, 1 lygio, jei keli lygiai."

msgid "Major section heading level 2"
msgstr "Pagrindinė skyriaus antraštė 2 lygio"

msgid "A major section division heading, level 2."
msgstr "Pagrindinio skirsnio padalijimo antraštė, 2 lygio."

msgid "Major section reference range"
msgstr "Pagrindinio skirsnio nuorodų intervalas"

msgid "The text reference range listed under a major section heading."
msgstr "Teksto nuorodų intervalas, nurodytas po pagrindinio skirsnio antrašte."

msgid "Section heading"
msgstr "Skirsnio antraštė"

msgid "A section heading, level 1, if single level."
msgstr "Skirsnio antraštė, 1 lygio, jei vienas lygis."

msgid "Section heading level 1"
msgstr "Skirsnio antraštė 1 lygio"

msgid "A section heading, level 1, if multiple levels."
msgstr "Skirsnio antraštė, 1 lygio, jei keli lygiai."

msgid "Section heading level 2"
msgstr "Skirsnio antraštė 2 lygio"

msgid "A section heading, level 2."
msgstr "Skirsnio antraštė, 2 lygio."

msgid "Section heading level 3"
msgstr "Skirsnio antraštė 3 lygio"

msgid "A section heading, level 3."
msgstr "Skirsnio antraštė, 3 lygio."

msgid "Section heading level 4"
msgstr "Skirsnio antraštė 4 lygio"

msgid "A section heading, level 4."
msgstr "Skirsnio antraštė, 4 lygio."

msgid "Section reference range"
msgstr "Skirsnio nuorodų intervalas"

msgid "The text reference range listed under a section heading."
msgstr "Teksto nuorodų intervalas, nurodytas po skirsnio antrašte."

msgid "Parallel passage references"
msgstr "Paralelinių ištraukų nuorodos"

msgid "Parallel references."
msgstr "Paralelinės nuorodos."

msgid "Inline quotation references"
msgstr "Įterptinių citatų nuorodos"

msgid ""
"A cross-reference indicating the source text for the preceding quotation."
msgstr "Kryžminė nuoroda, nurodanti ankstesnės citatos šaltinio tekstą."

msgid "Descriptive title or Hebrew subtitle"
msgstr "Aprašomoji antraštė arba hebrajų paantraštė"

msgid "A Hebrew text heading, to provide description, e.g. Psalms."
msgstr "Hebrajų teksto antraštė aprašymui pateikti, pvz., Psalmės."

msgid "Speaker"
msgstr "Kalbėtojas"

msgid "A heading to identify the speaker."
msgstr "Antraštė kalbėtojui nurodyti."

msgid "Semantic division"
msgstr "Semantinis padalijimas"

msgid ""
"Vertical space used to divide the text into sections, in a manner similar to "
"the structure added through the use of a sequence of heading texts."
msgstr "Vertikalus tarpas, naudojamas tekstui skirstyti į skirsnius panašiai kaip struktūra, sukuriama naudojant antraščių tekstų seką."

msgid "Semantic division level 1"
msgstr "Semantinis padalijimas 1 lygio"

msgid "Semantic division level 2"
msgstr "Semantinis padalijimas 2 lygio"

msgid "Semantic division level 3"
msgstr "Semantinis padalijimas 3 lygio"

msgid "Semantic division level 4"
msgstr "Semantinis padalijimas 4 lygio"

msgid "Chapter number"
msgstr "Skyriaus numeris"

msgid "For the chapter number."
msgstr "Skyriaus numeriui."

msgid "Alternate chapter number"
msgstr "Alternatyvus skyriaus numeris"

msgid ""
"Second or alternate chapter number. For coding dual versification. Useful "
"for places where different traditions of chapter breaks need to be supported "
"in the same translation."
msgstr "Antras ar alternatyvus skyriaus numeris. Dvigubam eilučių numeravimui koduoti. Naudinga vietose, kur tame pačiame vertime reikia palaikyti skirtingas skyrių skirstymo tradicijas."

msgid "Chapter label"
msgstr "Skyriaus etiketė"

msgid ""
"Chapter label used for translations that add a word such as 'Chapter' before "
"chapter numbers, e.g. Psalms."
msgstr "Skyriaus etiketė, naudojama vertimuose, kurie prieš skyrių numerius prideda žodį, pvz., „Skyrius“, pvz., Psalmės."

msgid "Published chapter character"
msgstr "Paskelbtas skyriaus simbolis"

msgid ""
"Published chapter number. This is a chapter marking that would be used in "
"the published text."
msgstr "Paskelbtas skyriaus numeris. Tai skyriaus žymėjimas, kuris būtų naudojamas paskelbtame tekste."

msgid "Chapter description"
msgstr "Skyriaus aprašymas"

msgid "For a brief description of the chapter content."
msgstr "Trumpam skyriaus turinio aprašymui."

msgid "Verse number"
msgstr "Eilutės numeris"

msgid "A verse number."
msgstr "Eilutės numeris."

msgid "Alternate verse number"
msgstr "Alternatyvus eilutės numeris"

msgid "Second or alternate verse number. For coding dual verse numeration."
msgstr "Antras ar alternatyvus eilutės numeris. Dvigubam eilučių numeravimui koduoti."

msgid "Published verse marker"
msgstr "Paskelbta eilutės žyma"

msgid ""
"Published verse marker. This is a verse marking that would be used in the "
"published text."
msgstr "Paskelbta eilutės žyma. Tai eilutės žymėjimas, kuris būtų naudojamas paskelbtame tekste."

msgid "Normal paragraph"
msgstr "Įprasta pastraipa"

msgid "Paragraph text, with first line indent."
msgstr "Pastraipos tekstas su pirmos eilutės įtrauka."

msgid "Continuation paragraph"
msgstr "Tęsinio pastraipa"

msgid "Margin paragraph text, with no first line indent."
msgstr "Paraštinės pastraipos tekstas be pirmos eilutės įtraukos."

msgid "Paragraph opening an epistle"
msgstr "Pastraipa, pradedanti laišką"

msgid "Paragraph opening an epistle or letter, without first line indent."
msgstr "Pastraipa, pradedanti laišką ar epistolą, be pirmos eilutės įtraukos."

msgid "Right-aligned paragraph"
msgstr "Dešinėn lygiuota pastraipa"

msgid "Right-aligned paragraph text, without first line indent."
msgstr "Dešinėn lygiuotos pastraipos tekstas be pirmos eilutės įtraukos."

msgid "Closure of a letter"
msgstr "Laiško pabaiga"

msgid "For a closure of an letter."
msgstr "Laiško pabaigai."

msgid "Embedded text opening"
msgstr "Įterpto teksto pradžia"

msgid "For an embedded text opening."
msgstr "Įterpto teksto pradžiai."

msgid "Embedded text paragraph"
msgstr "Įterpto teksto pastraipa"

msgid "For an embedded text paragraph."
msgstr "Įterpto teksto pastraipai."

msgid "Embedded text closing"
msgstr "Įterpto teksto pabaiga"

msgid "For an embedded text closing."
msgstr "Įterpto teksto pabaigai."

msgid "Embedded text refrain"
msgstr "Įterpto teksto priedainis"

msgid "Embedded text refrain, e.g. Then all the people shall say, Amen!"
msgstr "Įterpto teksto priedainis, pvz., Ir visi žmonės tars: Amen!"

msgid "Indented paragraph"
msgstr "Pastraipa su įtrauka"

msgid ""
"Paragraph text, level 1 indent if single level, with first line indent; "
"often used for discourse."
msgstr "Pastraipos tekstas, 1 lygio įtrauka, jei vienas lygis, su pirmos eilutės įtrauka; dažnai naudojama kalbai."

msgid "Indented paragraph level 1"
msgstr "Pastraipa su įtrauka 1 lygio"

msgid ""
"Paragraph text, level 1 indent if multiple levels, with first line indent; "
"often used for discourse."
msgstr "Pastraipos tekstas, 1 lygio įtrauka, jei keli lygiai, su pirmos eilutės įtrauka; dažnai naudojama kalbai."

msgid "Indented paragraph level 2"
msgstr "Pastraipa su įtrauka 2 lygio"

msgid ""
"Paragraph text, level 2 indent if multiple levels, with first line indent; "
"often used for discourse."
msgstr "Pastraipos tekstas, 2 lygio įtrauka, jei keli lygiai, su pirmos eilutės įtrauka; dažnai naudojama kalbai."

msgid "Indented paragraph level 3"
msgstr "Pastraipa su įtrauka 3 lygio"

msgid ""
"Paragraph text, level 3 indent if multiple levels, with first line indent; "
"often used for discourse."
msgstr "Pastraipos tekstas, 3 lygio įtrauka, jei keli lygiai, su pirmos eilutės įtrauka; dažnai naudojama kalbai."

msgid "Indented flush left paragraph"
msgstr "Įtraukta kairėn lygiuota pastraipa"

msgid ""
"Margin paragraph text, indented, with no first line indent, often used for "
"discourse."
msgstr "Paraštinės pastraipos tekstas, įtrauktas, be pirmos eilutės įtraukos, dažnai naudojamas kalbai."

msgid "No break with previous paragraph"
msgstr "Be pertraukos su ankstesne pastraipa"

msgid ""
"Paragraph text, with no break from previous paragraph text at chapter "
"boundary."
msgstr "Pastraipos tekstas be pertraukos nuo ankstesnės pastraipos teksto skyriaus riboje."

msgid "Centered paragraph"
msgstr "Centruota pastraipa"

msgid "Paragraph text, centered, for inscription."
msgstr "Pastraipos tekstas, centruotas, užrašui."

msgid "Paragraph with hanging indent"
msgstr "Pastraipa su kabančia įtrauka"

msgid "Indented paragraph with hanging indent."
msgstr "Pastraipa su įtrauka ir kabančia įtrauka."

msgid "Paragraph with hanging indent level 1"
msgstr "Pastraipa su kabančia įtrauka 1 lygio"

msgid "Indented paragraph with hanging indent, level 1 if multiple levels."
msgstr "Pastraipa su įtrauka ir kabančia įtrauka, 1 lygio, jei keli lygiai."

msgid "Paragraph with hanging indent level 2"
msgstr "Pastraipa su kabančia įtrauka 2 lygio"

msgid "Indented paragraph with hanging indent, level 2."
msgstr "Pastraipa su įtrauka ir kabančia įtrauka, 2 lygio."

msgid "Paragraph with hanging indent level 3"
msgstr "Pastraipa su kabančia įtrauka 3 lygio"

msgid "Indented paragraph with hanging indent, level 3."
msgstr "Pastraipa su įtrauka ir kabančia įtrauka, 3 lygio."

msgid "Paragraph with hanging indent level 4"
msgstr "Pastraipa su kabančia įtrauka 4 lygio"

msgid "Indented paragraph with hanging indent, level 4."
msgstr "Pastraipa su įtrauka ir kabančia įtrauka, 4 lygio."

msgid "Blank line"
msgstr "Tuščia eilutė"

msgid ""
"May be used to explicitly indicate additional white space between "
"paragraphs. Poetry text stanza break."
msgstr "Gali būti naudojama aiškiai nurodyti papildomą tuščią erdvę tarp pastraipų. Poezijos teksto posmo pertrauka."

msgid "Poetic line"
msgstr "Poetinė eilutė"

msgid "Poetry text, level 1 indent if single level."
msgstr "Poezijos tekstas, 1 lygio įtrauka, jei vienas lygis."

msgid "Poetry text, level 1 indent if multiple levels."
msgstr "Poezijos tekstas, 1 lygio įtrauka, jei keli lygiai."

msgid "Poetry text, level 2 indent."
msgstr "Poezijos tekstas, 2 lygio įtrauka."

msgid "Poetry text, level 3 indent."
msgstr "Poezijos tekstas, 3 lygio įtrauka."

msgid "Right-aligned poetic line"
msgstr "Dešinėn lygiuota poetinė eilutė"

msgid "Commonly used for a poetic refrain."
msgstr "Dažnai naudojama poetiniam priedainiui."

msgid "Centered poetic line"
msgstr "Centruota poetinė eilutė"

msgid "Poetry text, centered."
msgstr "Poezijos tekstas, centruotas."

msgid "Selah"
msgstr "Sela"

msgid "Poetry text, Selah."
msgstr "Poezijos tekstas, Sela."

msgid "Acrostic heading"
msgstr "Akrostiko antraštė"

msgid "Poetry text, acrostic marker or heading."
msgstr "Poezijos tekstas, akrostiko žyma ar antraštė."

msgid "Acrostic letter"
msgstr "Akrostiko raidė"

msgid ""
"Poetry text, acrostic markup of the first character of a line of acrostic "
"poetry."
msgstr "Poezijos tekstas, akrostikinės poezijos eilutės pirmojo simbolio akrostiko žymėjimas."

msgid "Embedded text poetic line"
msgstr "Įterpto teksto poetinė eilutė"

msgid "Poetry text, embedded, level 1 indent, if single level."
msgstr "Poezijos tekstas, įterptas, 1 lygio įtrauka, jei vienas lygis."

msgid "Embedded text poetic line level 1"
msgstr "Įterpto teksto poetinė eilutė 1 lygio"

msgid "Poetry text, embedded, level 1 indent, if multiple levels."
msgstr "Poezijos tekstas, įterptas, 1 lygio įtrauka, jei keli lygiai."

msgid "Embedded text poetic line level 2"
msgstr "Įterpto teksto poetinė eilutė 2 lygio"

msgid "Poetry text, embedded, level 2 indent."
msgstr "Poezijos tekstas, įterptas, 2 lygio įtrauka."

msgid "Embedded text poetic line level 3"
msgstr "Įterpto teksto poetinė eilutė 3 lygio"

msgid "Poetry text, embedded, level 3 indent."
msgstr "Poezijos tekstas, įterptas, 3 lygio įtrauka."

msgid "Hebrew note"
msgstr "Hebrajų pastaba"

msgid ""
"A Hebrew musical performance comment similar in content to many of the "
"Hebrew Psalm titles, but placed at the end of the poetic section."
msgstr "Hebrajų muzikinio atlikimo komentaras, turiniu panašus į daugelį hebrajų Psalmių pavadinimų, bet pateiktas poetinės dalies pabaigoje."

msgid "List header"
msgstr "Sąrašo antraštė"

msgid ""
"Some lists include an introductory and concluding remark. They are an "
"integral part of the list content, but are not list items. A list does not "
"require either or both of these elements."
msgstr "Kai kuriuose sąrašuose yra įžanginė ir baigiamoji pastaba. Jos yra neatskiriama sąrašo turinio dalis, bet nėra sąrašo elementai. Sąrašui nereikia nei vieno, nei abiejų šių elementų."

msgid "List entry"
msgstr "Sąrašo įrašas"

msgid "List entry level 1"
msgstr "Sąrašo įrašas 1 lygio"

msgid "List entry level 2"
msgstr "Sąrašo įrašas 2 lygio"

msgid "List entry level 3"
msgstr "Sąrašo įrašas, 3 lygio."

msgid "A list entry, level 3."
msgstr "Sąrašo įrašas 3 lygio"

msgid "List entry level 4"
msgstr "Sąrašo įrašas 4 lygio"

msgid "A list entry, level 4."
msgstr "Sąrašo įrašas, 4 lygio."

msgid "List footer"
msgstr "Sąrašo poraštė"

msgid "Embedded list entry"
msgstr "Įterptas sąrašo įrašas"

msgid ""
"An out-dented paragraph meant to highlight the items of an embedded list."
msgstr "Pastraipa su išstumta įtrauka, skirta išryškinti įterpto sąrašo elementus."

msgid "Embedded list entry level 1"
msgstr "Įterptas sąrašo įrašas 1 lygio"

msgid ""
"An out-dented paragraph meant to highlight the items of an embedded list, "
"level 1."
msgstr "Pastraipa su išstumta įtrauka, skirta išryškinti įterpto sąrašo elementus, 1 lygio."

msgid "Embedded list entry level 2"
msgstr "Įterptas sąrašo įrašas 2 lygio"

msgid ""
"An out-dented paragraph meant to highlight the items of an embedded list, "
"level 2."
msgstr "Pastraipa su išstumta įtrauka, skirta išryškinti įterpto sąrašo elementus, 2 lygio."

msgid "List entry total"
msgstr "Sąrašo įrašo suma"

msgid ""
"Use in accounting lists for denoting the total component of the text within "
"a list item."
msgstr "Naudojama apskaitos sąrašuose sumos komponentui sąrašo elemente žymėti."

msgid "List entry key"
msgstr "Sąrašo įrašo raktas"

msgid "For list entry key content."
msgstr "Sąrašo įrašo rakto turiniui."

msgid "List entry value"
msgstr "Sąrašo įrašo reikšmė"

msgid "For list entry value content."
msgstr "Sąrašo įrašo reikšmės turiniui."

msgid "List entry value level 1"
msgstr "Sąrašo įrašo reikšmė 1 lygio"

msgid "For list entry value content level 1."
msgstr "Sąrašo įrašo reikšmės turiniui 1 lygio."

msgid "List entry value level 2"
msgstr "Sąrašo įrašo reikšmė 2 lygio"

msgid "For list entry value content level 2."
msgstr "Sąrašo įrašo reikšmės turiniui 2 lygio."

msgid "Table row start"
msgstr "Lentelės eilutės pradžia"

msgid "A new table row."
msgstr "Nauja lentelės eilutė."

msgid "Table column 1 heading"
msgstr "Lentelės 1 stulpelio antraštė"

msgid "A table heading, column 1."
msgstr "Lentelės antraštė, 1 stulpelis."

msgid "Table column 2 heading"
msgstr "Lentelės 2 stulpelio antraštė"

msgid "A table heading, column 2."
msgstr "Lentelės antraštė, 2 stulpelis."

msgid "Table column 3 heading"
msgstr "Lentelės 3 stulpelio antraštė"

msgid "A table heading, column 3."
msgstr "Lentelės antraštė, 3 stulpelis."

msgid "Table column 4 heading"
msgstr "Lentelės 4 stulpelio antraštė"

msgid "A table heading, column 4."
msgstr "Lentelės antraštė, 4 stulpelis."

msgid "Right aligned table column 1 heading"
msgstr "Dešinėn lygiuota lentelės 1 stulpelio antraštė"

msgid "A table heading, column 1, right aligned."
msgstr "Lentelės antraštė, 1 stulpelis, lygiuota dešinėn."

msgid "Right aligned table column 2 heading"
msgstr "Dešinėn lygiuota lentelės 2 stulpelio antraštė"

msgid "A table heading, column 2, right aligned."
msgstr "Lentelės antraštė, 2 stulpelis, lygiuota dešinėn."

msgid "Right aligned table column 3 heading"
msgstr "Dešinėn lygiuota lentelės 3 stulpelio antraštė"

msgid "A table heading, column 3, right aligned."
msgstr "Lentelės antraštė, 3 stulpelis, lygiuota dešinėn."

msgid "Right aligned table column 4 heading"
msgstr "Dešinėn lygiuota lentelės 4 stulpelio antraštė"

msgid "A table heading, column 4, right aligned."
msgstr "Lentelės antraštė, 4 stulpelis, lygiuota dešinėn."

msgid "Table column 1 cell"
msgstr "Lentelės 1 stulpelio langelis"

msgid "A table cell item, column 1."
msgstr "Lentelės langelio elementas, 1 stulpelis."

msgid "Table column 2 cell"
msgstr "Lentelės 2 stulpelio langelis"

msgid "A table cell item, column 2."
msgstr "Lentelės langelio elementas, 2 stulpelis."

msgid "Table column 3 cell"
msgstr "Lentelės 3 stulpelio langelis"

msgid "A table cell item, column 3."
msgstr "Lentelės langelio elementas, 3 stulpelis."

msgid "Table column 4 cell"
msgstr "Lentelės 4 stulpelio langelis"

msgid "A table cell item, column 4."
msgstr "Lentelės langelio elementas, 4 stulpelis."

msgid "Right aligned table cell column 1"
msgstr "Dešinėn lygiuotas lentelės langelis 1 stulpelis"

msgid "A table cell item, column 1, right aligned."
msgstr "Lentelės langelio elementas, 1 stulpelis, lygiuota dešinėn."

msgid "Right aligned table cell column 2"
msgstr "Dešinėn lygiuotas lentelės langelis 2 stulpelis"

msgid "A table cell item, column 2, right aligned."
msgstr "Lentelės langelio elementas, 2 stulpelis, lygiuota dešinėn."

msgid "Right aligned table cell column 3"
msgstr "Dešinėn lygiuotas lentelės langelis 3 stulpelis"

msgid "A table cell item, column 3, right aligned."
msgstr "Lentelės langelio elementas, 3 stulpelis, lygiuota dešinėn."

msgid "Right aligned table cell column 4"
msgstr "Dešinėn lygiuotas lentelės langelis 4 stulpelis"

msgid "A table cell item, column 4, right aligned."
msgstr "Lentelės langelio elementas, 4 stulpelis, lygiuota dešinėn."

msgid "Footnote"
msgstr "Išnaša"

msgid "A footnote text item."
msgstr "Išnašos teksto elementas."

msgid "Endnote"
msgstr "Galinė išnaša"

msgid "An endnote text item."
msgstr "Galinės išnašos teksto elementas."

msgid "Footnote origin reference"
msgstr "Išnašos kilmės nuoroda"

msgid "This is the chapter and verse or verses that note refers to."
msgstr "Tai skyrius ir eilutė ar eilutės, į kurias pastaba nurodo."

msgid "Footnote translation quotation"
msgstr "Išnašos vertimo citata"

msgid ""
"A quotation from the current scripture text translation for which the note "
"is being provided."
msgstr "Citata iš dabartinio Šventojo Rašto teksto vertimo, kuriam pateikiama pastaba."

msgid "Footnote alternate translation"
msgstr "Išnašos alternatyvus vertimas"

msgid ""
"Used to distinguish between a quotation of the current scripture text "
"translation, and an alternate translation."
msgstr "Naudojama atskirti dabartinio Šventojo Rašto teksto vertimo citatą nuo alternatyvaus vertimo."

msgid "Footnote keyword"
msgstr "Išnašos raktažodis"

msgid ""
"The specific keyword or term from the text for which the footnote is being "
"provided."
msgstr "Konkretus raktažodis ar terminas iš teksto, kuriam pateikiama išnaša."

msgid "Footnote label text"
msgstr "Išnašos etiketės tekstas"

msgid ""
"Can be used for labeling word(s) which are used consistently across certain "
"types of translation notes, such as the words 'Or' in an alternative "
"translation note, 'Others', 'Heb.', 'LXX' etc."
msgstr "Gali būti naudojamas žymėti žodžiams, kurie nuosekliai naudojami tam tikrų tipų vertimo pastabose, pvz., žodis „Arba“ alternatyvaus vertimo pastaboje, „Kiti“, „Hbr.“, „LXX“ ir t. t."

msgid "Footnote witness list"
msgstr "Išnašos liudytojų sąrašas"

msgid ""
"For distinguishing a list of sigla representing witnesses in critical "
"editions."
msgstr "Skirta atskirti sigla sąrašą, atstovaujantį liudytojams kritiniuose leidimuose."

msgid "Footnote additional paragraph"
msgstr "Išnašos papildoma pastraipa"

msgid ""
"Use this marker to if you need to indicate the start of a new paragraph "
"within a footnote."
msgstr "Naudokite šią žymą, jei reikia nurodyti naujos pastraipos pradžią išnašoje."

msgid "Footnote verse number"
msgstr "Išnašos eilutės numeris"

msgid "A verse number within the footnote text."
msgstr "Eilutės numeris išnašos tekste."

msgid "Footnote text"
msgstr "Išnašos tekstas"

msgid "The essential or explanatory text of the footnote."
msgstr "Esminis ar aiškinamasis išnašos tekstas."

msgid "Footnote Deuterocanonical content"
msgstr "Išnašos deuterokanoninis turinys"

msgid ""
"Text between these markers is material to be included only in published "
"editions that contain the Deuterocanonical books."
msgstr "Tekstas tarp šių žymų yra medžiaga, įtraukiama tik į išleistus leidimus, kuriuose yra deuterokanoninės knygos."

msgid "Footnote reference mark"
msgstr "Išnašos nuorodos žyma"

msgid "An additional footnote marker location for a previous footnote."
msgstr "Papildoma išnašos žymos vieta ankstesnei išnašai."

msgid "Cross reference"
msgstr "Kryžminė nuoroda"

msgid "A list of cross references."
msgstr "Kryžminių nuorodų sąrašas."

msgid "Cross reference origin reference"
msgstr "Kryžminės nuorodos kilmės nuoroda"

msgid ""
"This is the chapter and verse or verses that target references are being "
"provided for."
msgstr "Tai skyrius ir eilutė ar eilutės, kurioms pateikiamos tikslinės nuorodos."

msgid "Cross reference keyword"
msgstr "Kryžminės nuorodos raktažodis"

msgid ""
"A keyword from the scripture translation text which the target references "
"also refer to."
msgstr "Raktažodis iš Šventojo Rašto vertimo teksto, į kurį taip pat nurodo tikslinės nuorodos."

msgid "Cross reference quotation"
msgstr "Kryžminės nuorodos citata"

msgid "A cross reference quotation from the scripture text."
msgstr "Kryžminės nuorodos citata iš Šventojo Rašto teksto."

msgid "Cross reference target references"
msgstr "Kryžminės nuorodos tikslinės nuorodos"

msgid "The cross reference target references."
msgstr "Kryžminės nuorodos tikslinės nuorodos."

msgid "Target references added text"
msgstr "Tikslinių nuorodų pridėtas tekstas"

msgid "Used for marking text added to the target references."
msgstr "Naudojama žymėti tekstą, pridėtą prie tikslinių nuorodų."

msgid "Published cross reference origin text"
msgstr "Paskelbtas kryžminės nuorodos kilmės tekstas"

msgid "Supplies the origin text intended for publishing."
msgstr "Pateikia kilmės tekstą, skirtą leidybai."

msgid "Cross reference Old Testament"
msgstr "Kryžminė nuoroda Senasis Testamentas"

msgid ""
"Content between these markers is for inclusion in editions that contain the "
"Old Testament books."
msgstr "Turinys tarp šių žymų skirtas įtraukti į leidimus, kuriuose yra Senojo Testamento knygos."

msgid "Cross reference New Testament"
msgstr "Kryžminė nuoroda Naujasis Testamentas"

msgid ""
"Content between these markers is for inclusion in editions that contain the "
"New Testament books."
msgstr "Turinys tarp šių žymų skirtas įtraukti į leidimus, kuriuose yra Naujojo Testamento knygos."

msgid "Cross reference deuterocanonical"
msgstr "Kryžminė nuoroda deuterokanoninė"

msgid ""
"Content between these markers is for inclusion in editions that contain the "
"Deuterocanonical books."
msgstr "Turinys tarp šių žymų skirtas įtraukti į leidimus, kuriuose yra deuterokanoninės knygos."

msgid "Translator’s addition"
msgstr "Vertėjo priedas"

msgid ""
"A translator’s explanation - words added by the translator for clarity – "
"text which is not literally a part of the original language, but which was "
"supplied to make the meaning of the original clear."
msgstr "Vertėjo paaiškinimas – žodžiai, kuriuos vertėjas pridėjo aiškumo dėlei – tekstas, kuris pažodžiui nėra originalo kalbos dalis, bet pateiktas originalo prasmei išryškinti."

msgid "Quoted book title"
msgstr "Cituojamas knygos pavadinimas"

msgid "For the quoted name of a book."
msgstr "Cituojamam knygos pavadinimui."

