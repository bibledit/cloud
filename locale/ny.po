msgstr "Mutu wa tebulo, mzati 1."

msgid "Table column 2 heading"
msgstr "Mutu wa mzati 2 wa tebulo"

msgid "A table heading, column 2."
msgstr "Mutu wa tebulo, mzati 2."

msgid "Table column 3 heading"
msgstr "Mutu wa mzati 3 wa tebulo"

msgid "A table heading, column 3."
msgstr "Mutu wa tebulo, mzati 3."

msgid "Table column 4 heading"
msgstr "Mutu wa mzati 4 wa tebulo"

msgid "A table heading, column 4."
msgstr "Mutu wa tebulo, mzati 4."

msgid "Right aligned table column 1 heading"
msgstr "Mutu wa mzati 1 wa tebulo woikidwa kumanja"

msgid "A table heading, column 1, right aligned."
msgstr "Mutu wa tebulo, mzati 1, woikidwa kumanja."

msgid "Right aligned table column 2 heading"
msgstr "Mutu wa mzati 2 wa tebulo woikidwa kumanja"

msgid "A table heading, column 2, right aligned."
msgstr "Mutu wa tebulo, mzati 2, woikidwa kumanja."

msgid "Right aligned table column 3 heading"
msgstr "Mutu wa mzati 3 wa tebulo woikidwa kumanja"

msgid "A table heading, column 3, right aligned."
msgstr "Mutu wa tebulo, mzati 3, woikidwa kumanja."

msgid "Right aligned table column 4 heading"
msgstr "Mutu wa mzati 4 wa tebulo woikidwa kumanja"

