msgstr "Tazwart"

msgid "Installation"
msgstr "Asbadu"

msgid "Methodology"
msgstr "Tarrayt"

msgid "Navigation"
msgstr "Unnig"

msgid "Keyboard shortcuts"
msgstr "Inegzumen n unasiw"

msgid "Screen swiping"
msgstr "Asegrew n ugdil"

