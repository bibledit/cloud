msgstr "Tzemreḍ ad tsekcmeḍ URLs n yisebtar n Bibledit n daxel neɣ isebtar n beṛṛa i usken."

msgid ""
"Enter their relative widths as an integer factor relative to the overall "
"width and other panes."
msgstr "Sekcem tehri-nsen almend n arwas ummid almend n tehri n lekmal d tmeẓlayin-nniḍen."

