msgstr "Básnický text, vložený, odsazení úrovně 1, pokud je jedna úroveň."

msgid "Embedded text poetic line level 1"
msgstr "Básnický řádek vloženého textu, úroveň 1"

msgid "Poetry text, embedded, level 1 indent, if multiple levels."
msgstr "Básnický text, vložený, odsazení úrovně 1, pokud je více úrovní."

msgid "Embedded text poetic line level 2"
msgstr "Básnický řádek vloženého textu, úroveň 2"

msgid "Poetry text, embedded, level 2 indent."
msgstr "Básnický text, vložený, odsazení úrovně 2."

