msgstr "Un encabezado de tabla, columna 3."

msgid "Table column 4 heading"
msgstr "Encabezado de la columna 4 de la tabla"

msgid "A table heading, column 4."
msgstr "Un encabezado de tabla, columna 4."

msgid "Right aligned table column 1 heading"
msgstr "Encabezado de la columna 1 de la tabla alineado a la derecha"

msgid "A table heading, column 1, right aligned."
msgstr "Un encabezado de tabla, columna 1, alineado a la derecha."

msgid "Right aligned table column 2 heading"
msgstr "Encabezado de la columna 2 de la tabla alineado a la derecha"

msgid "A table heading, column 2, right aligned."
msgstr "Un encabezado de tabla, columna 2, alineado a la derecha."

msgid "Right aligned table column 3 heading"
msgstr "Encabezado de la columna 3 de la tabla alineado a la derecha"

msgid "A table heading, column 3, right aligned."
msgstr "Un encabezado de tabla, columna 3, alineado a la derecha."

msgid "Right aligned table column 4 heading"
msgstr "Encabezado de la columna 4 de la tabla alineado a la derecha"

msgid "A table heading, column 4, right aligned."
msgstr "Un encabezado de tabla, columna 4, alineado a la derecha."

msgid "Table column 1 cell"
msgstr "Celda de la columna 1 de la tabla"

msgid "A table cell item, column 1."
msgstr "Un elemento de celda de tabla, columna 1."

msgid "Table column 2 cell"
msgstr "Celda de la columna 2 de la tabla"

msgid "A table cell item, column 2."
msgstr "Un elemento de celda de tabla, columna 2."

msgid "Table column 3 cell"
msgstr "Celda de la columna 3 de la tabla"

msgid "A table cell item, column 3."
msgstr "Un elemento de celda de tabla, columna 3."

msgid "Table column 4 cell"
msgstr "Celda de la columna 4 de la tabla"

msgid "A table cell item, column 4."
msgstr "Un elemento de celda de tabla, columna 4."

