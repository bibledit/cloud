msgstr "Cholowa cha mndandanda"

msgid "List entry level 1"
msgstr "Cholowa cha mndandanda mlingo 1"

msgid "List entry level 2"
msgstr "Cholowa cha mndandanda mlingo 2"

msgid "List entry level 3"
msgstr "Cholowa cha mndandanda, mlingo 3."

msgid "A list entry, level 3."
msgstr "Cholowa cha mndandanda mlingo 3"

msgid "List entry level 4"
msgstr "Cholowa cha mndandanda mlingo 4"

msgid "A list entry, level 4."
msgstr "Cholowa cha mndandanda, mlingo 4."

msgid "List footer"
msgstr "Pansi pa mndandanda"

msgid "Embedded list entry"
msgstr "Cholowa cha mndandanda cholowetsedwa"

msgid ""
"An out-dented paragraph meant to highlight the items of an embedded list."
msgstr "Ndime yotulukira kunja yoyang'ana kuwonetsa zinthu za mndandanda wolowetsedwa."

msgid "Embedded list entry level 1"
msgstr "Cholowa cha mndandanda cholowetsedwa mlingo 1"

msgid ""
"An out-dented paragraph meant to highlight the items of an embedded list, "
"level 1."
msgstr "Ndime yotulukira kunja yoyang'ana kuwonetsa zinthu za mndandanda wolowetsedwa, mlingo 1."

msgid "Embedded list entry level 2"
msgstr "Cholowa cha mndandanda cholowetsedwa mlingo 2"

msgid ""
"An out-dented paragraph meant to highlight the items of an embedded list, "
"level 2."
msgstr "Ndime yotulukira kunja yoyang'ana kuwonetsa zinthu za mndandanda wolowetsedwa, mlingo 2."

msgid "List entry total"
msgstr "Chiwerengero chonse cha cholowa cha mndandanda"

msgid ""
"Use in accounting lists for denoting the total component of the text within "
"a list item."
msgstr "Gwiritsani ntchito mu mindandanda ya zowerengera kusonyeza gawo la chiwerengero chonse la mawu mu chinthu cha mndandanda."

msgid "List entry key"
msgstr "Kiyi ya cholowa cha mndandanda"

msgid "For list entry key content."
msgstr "Ya zomwe zili mu kiyi ya cholowa cha mndandanda."

msgid "List entry value"
msgstr "Mtengo wa cholowa cha mndandanda"

msgid "For list entry value content."
msgstr "Ya zomwe zili mu mtengo wa cholowa cha mndandanda."

msgid "List entry value level 1"
msgstr "Mtengo wa cholowa cha mndandanda mlingo 1"

msgid "For list entry value content level 1."
msgstr "Ya zomwe zili mu mtengo wa cholowa cha mndandanda mlingo 1."

msgid "List entry value level 2"
msgstr "Mtengo wa cholowa cha mndandanda mlingo 2"

msgid "For list entry value content level 2."
msgstr "Ya zomwe zili mu mtengo wa cholowa cha mndandanda mlingo 2."

msgid "Table row start"
msgstr "Kuyamba kwa mzere wa tebulo"

