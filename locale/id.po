msgstr "Digunakan dalam daftar akuntansi untuk menandai komponen total dari teks dalam butir daftar."

msgid "List entry key"
msgstr "Kunci entri daftar"

msgid "For list entry key content."
msgstr "Untuk isi kunci entri daftar."

msgid "List entry value"
msgstr "Nilai entri daftar"

