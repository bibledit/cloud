msgstr "Iš kairės į dešinę"

msgid "Right-to-left"
msgstr "Iš dešinės į kairę"

msgid "Writing mode"
msgstr "Rašymo režimas"

msgid "Top to bottom and left to right"
msgstr "Iš viršaus į apačią ir iš kairės į dešinę"

msgid "Top to bottom and right to left"
msgstr "Iš viršaus į apačią ir iš dešinės į kairę"

msgid "Bottom to top and left to right"
msgstr "Iš apačios į viršų ir iš kairės į dešinę"

