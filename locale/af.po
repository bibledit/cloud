msgstr "Begin of opening van die kantbalk-inhoudsafdeling."

msgid "Sidebar end"
msgstr "Kantbalk-einde"

msgid "End or closing of the sidebar content section."
msgstr "Einde of sluiting van die kantbalk-inhoudsafdeling."

msgid "Category tag"
msgstr "Kategoriemerker"

msgid "Extended note or sidebar category tag."
msgstr "Uitgebreide nota- of kantbalk-kategoriemerker."

msgid "Peripheral"
msgstr "Perifeer"

msgid "Division for peripheral content."
msgstr "Afdeling vir perifere inhoud."

msgid "Link text"
msgstr "Skakelteks"

msgid ""
"Optionally used for associating linking attributes to a span of text when no"
