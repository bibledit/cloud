msgstr "Pembuka teks sisipan"

msgid "For an embedded text opening."
msgstr "Untuk pembuka teks sisipan."

msgid "Embedded text paragraph"
msgstr "Paragraf teks sisipan"

msgid "For an embedded text paragraph."
msgstr "Untuk paragraf teks sisipan."

msgid "Embedded text closing"
msgstr "Penutup teks sisipan"

msgid "For an embedded text closing."
msgstr "Untuk penutup teks sisipan."

