msgstr "Para el contenido de valor de una entrada de lista, nivel 1."

msgid "List entry value level 2"
msgstr "Valor de entrada de lista nivel 2"

msgid "For list entry value content level 2."
msgstr "Para el contenido de valor de una entrada de lista, nivel 2."

