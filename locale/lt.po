msgstr "Ilgas turinio tekstas"

msgid "Long table of contents text."
msgstr "Ilgas turinio lentelės tekstas."

msgid "Short TOC text"
msgstr "Trumpas turinio tekstas"

msgid "Short table of contents text."
msgstr "Trumpas turinio lentelės tekstas."

msgid "Book abbreviation"
msgstr "Knygos santrumpa"

msgid "Book abbreviation for the table of contents."
msgstr "Knygos santrumpa turinio lentelei."

